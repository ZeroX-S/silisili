+            dbus_bool_t valid = FALSE;
+            dbus_int32_t zero = 0;
+            if (reply)
+            {
+                dbus_message_append_args(reply,
+                                         DBUS_TYPE_BOOLEAN, &valid,
+                                         DBUS_TYPE_INT32, &zero,
+                                         DBUS_TYPE_INT32, &zero,
+                                         DBUS_TYPE_INT32, &zero,
+                                         DBUS_TYPE_INT32, &zero,
+                                         DBUS_TYPE_INVALID);
