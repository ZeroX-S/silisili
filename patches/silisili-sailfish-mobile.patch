+bool GLFWVideoContext::setContentOrientation(ContentOrientation orientation)
+{
+#ifdef SILISILI_SAILFISH_MOBILE
+    const bool supported = glfwSetWindowContentOrientation(this->window,
+                                                           static_cast<int>(orientation)) == GLFW_TRUE;
+    const ContentOrientation renderOrientation = orientation == ContentOrientation::LANDSCAPE
+                                                     ? ContentOrientation::LANDSCAPE
+                                                     : ContentOrientation::PORTRAIT;
+    if (VideoContext::CONTENT_ORIENTATION != renderOrientation)
+    {
+        VideoContext::CONTENT_ORIENTATION = renderOrientation;
+        Application::setWindowSize(Application::windowWidth, Application::windowHeight);
+        Application::getWindowSizeChangedEvent()->fire();
+        brls::Logger::info("Sailfish render orientation: {} physical={}x{} logical={}x{}",
+                           renderOrientation == ContentOrientation::LANDSCAPE ? "landscape" : "portrait",
+                           Application::windowWidth, Application::windowHeight,
+                           Application::contentWidth, Application::contentHeight);
+    }
+    return supported;
+#else
+    (void)orientation;
+    return false;
+#endif
+}
