+void VideoView::previewGestureSeeking(int seek) {
+    const float duration = getRealDuration();
+    if (duration <= 0) {
+        seeking_range = 0;
+        is_seeking = false;
+        return;
+    }
+
+    brls::cancelDelay(seeking_iter);
+    const double target = std::clamp(this->mpvCore->playback_time + seek, 0.0, (double)duration);
+    seeking_range = (int)std::lround(target - this->mpvCore->playback_time);
+    is_seeking = true;
+
+    showOSD(false);
+    showCenterHint();
+    setCenterHintIcon("svg/arrow-left-right.svg");
+    setCenterHintText(fmt::format("{:+d} s", seeking_range));
+    osdSlider->setProgress((float)(target / duration));
+    leftStatusLabel->setText(silisili::sec2Time(target));
+
+    auto& snapshot = VideoSnapshotCore::instance();
+    showThumbnailPreview = snapshot.isValid();
+    if (snapshot.isValid())
+        snapshot.preloadForTime(target);
+}
+
+void VideoView::finishGestureSeeking(bool commit) {
+    brls::cancelDelay(seeking_iter);
+    const int seek = seeking_range;
+    const float duration = getRealDuration();
+
+    hideCenterHint();
+    showThumbnailPreview = false;
+    seeking_range = 0;
+    is_seeking = false;
+
+    if (commit && seek != 0) {
+        mpvCore->seekRelative(seek);
+    } else if (duration > 0) {
+        osdSlider->setProgress((float)(mpvCore->playback_time / duration));
+        leftStatusLabel->setText(silisili::sec2Time(mpvCore->playback_time));
+    }
+    showOSD(true);
+}
