+                                      DBUS_TYPE_STRING, &text,
+                                      DBUS_TYPE_BOOLEAN, &autoRepeat,
+                                      DBUS_TYPE_INT32, &count,
+                                      DBUS_TYPE_BYTE, &requestType,
+                                      DBUS_TYPE_INVALID))
