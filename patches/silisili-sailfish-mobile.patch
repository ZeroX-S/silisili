+            }
+            return DBUS_HANDLER_RESULT_HANDLED;
+        }
+
+        if (dbus_message_has_interface(message, MALIIT_CLIENT_INTERFACE))
+        {
+            this->sendEmptyReply(callbackConnection, message);
+            return DBUS_HANDLER_RESULT_HANDLED;
+        }
