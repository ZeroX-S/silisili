+namespace {
+void migrateLegacySailfishConfig(const std::string& newDir, const std::string& homePath) {
+    if (cpr::fs::exists(newDir)) return;
+
+    const char* configHome = getenv("XDG_CONFIG_HOME");
+    std::string configBase = configHome ? std::string(configHome) : homePath + "/.config";
+    const std::string oldDir = configBase + "/wiliwili";
+    if (!cpr::fs::exists(oldDir) || !cpr::fs::is_directory(oldDir)) return;
+
+    try {
+        cpr::fs::copy(oldDir, newDir, cpr::fs::copy_options::recursive);
+        const std::string oldConfig = newDir + "/wiliwili_config.json";
+        const std::string newConfig = newDir + "/silisili_config.json";
+        if (cpr::fs::exists(oldConfig) && !cpr::fs::exists(newConfig)) {
+            cpr::fs::rename(oldConfig, newConfig);
+        }
+        brls::Logger::info("Migrated legacy Sailfish configuration to silisili");
+    } catch (const std::exception& e) {
+        brls::Logger::error("Unable to migrate legacy Sailfish configuration: {}", e.what());
+    }
+}
+}  // namespace
+#endif
