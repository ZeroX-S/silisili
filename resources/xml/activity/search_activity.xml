<brls:AppletFrame
        iconInterpolation="linear"
        headerHidden="true"
        footerHidden="false">
    <brls:Box
            axis="column"
            grow="1">
        <brls:Box
                width="100%"
                height="64"
                paddingLeft="16"
                paddingRight="10"
                alignItems="center">
            <brls:Box
                    id="search/box"
                    grow="1"
                    height="42"
                    backgroundColor="#E3E5E7"
                    paddingLeft="14"
                    paddingRight="14"
                    alignItems="center"
                    cornerRadius="6">
                <SVGImage
                        width="19"
                        height="18"
                        marginRight="10"
                        SVG="@res/svg/header-search-dark.svg"/>
                <brls:Label
                        id="search/label/key"
                        grow="1"
                        fontSize="15"
                        textColor="#18191c"
                        text="@i18n/silisili/home/common/search"/>
            </brls:Box>
            <ButtonClose marginLeft="8"/>
        </brls:Box>

        <SearchTab
                id="search/tab"
                grow="1"/>
    </brls:Box>
</brls:AppletFrame>
