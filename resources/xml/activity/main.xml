<brls:AppletFrame
        iconInterpolation="linear"
        headerHidden="true"
        footerHidden="true">
    <brls:Box
            axis="column"
            width="100%"
            height="100%">
        <brls:Box
                id="main/header"
                width="100%"
                height="60"
                shrink="0"
                paddingLeft="16"
                paddingRight="4"
                alignItems="center"
                backgroundColor="@theme/color/grey_1">
            <brls:Image
                    width="104"
                    height="30"
                    scalingType="fit"
                    image="@res/icon/silisili-logo.png"/>
            <brls:Box grow="1"/>
            <CustomButton
                    id="main/search"
                    width="52"
                    height="52"
                    focusable="true"
                    wireframe="false"
                    hideHighlightBackground="true"
                    highlightCornerRadius="8"
                    justifyContent="center"
                    alignItems="center">
                <SVGImage
                        width="24"
                        height="24"
                        SVG="@res/svg/header-search-dark.svg"/>
            </CustomButton>
            <CustomButton
                    id="main/inbox"
                    width="52"
                    height="52"
                    focusable="true"
                    wireframe="false"
                    hideHighlightBackground="true"
                    highlightCornerRadius="8"
                    justifyContent="center"
                    alignItems="center">
                <SVGImage
                        width="24"
                        height="24"
                        SVG="@res/svg/ico-inbox.svg"/>
            </CustomButton>
            <CustomButton
                    id="main/setting"
                    width="52"
                    height="52"
                    focusable="true"
                    wireframe="false"
                    hideHighlightBackground="true"
                    highlightCornerRadius="8"
                    justifyContent="center"
                    alignItems="center">
                <SVGImage
                        width="24"
                        height="24"
                        SVG="@res/svg/ico-setting.svg"/>
            </CustomButton>
        </brls:Box>

        <AutoTabFrame
                id="main/tabFrame"
                grow="1"
                tabHeight="60"
                tabBackgroundColor="@theme/color/grey_1"
                tabItemActiveTextColor="@theme/color/bilibili"
                disableNavigationDown="true"
                defaultTab="0"
                sidebarPosition="bottom">
            <Tab
                    label="@i18n/silisili/navigation/home"
                    fontSize="16"
                    style="plain"
                    icon="@res/svg/ico-home.svg"
                    iconActivate="@res/svg/ico-home-activate.svg">
                <HomeTab/>
            </Tab>
            <Tab
                    label="@i18n/silisili/navigation/dynamic"
                    fontSize="16"
                    style="plain"
                    icon="@res/svg/ico-dynamic.svg"
                    iconActivate="@res/svg/ico-dynamic-activate.svg">
                <DynamicTab/>
            </Tab>
            <Tab
                    label="@i18n/silisili/navigation/mine"
                    fontSize="16"
                    style="plain"
                    icon="@res/svg/ico-mine.svg"
                    iconActivate="@res/svg/ico-mine-activate.svg">
                <MineTab/>
            </Tab>
        </AutoTabFrame>
    </brls:Box>
</brls:AppletFrame>
