<brls:AppletFrame
        id="video/detail/frame"
        iconInterpolation="linear"
        headerHidden="true"
        footerHidden="true">
    <brls:Box
            id="video/detail/root"
            width="100%"
            height="100%"
            grow="1"
            axis="column">

        <brls:Box
                id="video_detail_left_box"
                width="100%"
                height="568"
                shrink="0"
                axis="column">
            <VideoView
                    id="video"
                    focusable="true"
                    focusDown="video_detail_info_box"
                    width="100%"
                    height="360"
                    aspectRatio="1.777778"
                    shrink="0"/>

            <brls:Box
                    id="video_detail_info_box"
                    width="100%"
                    height="208"
                    shrink="0"
                    axis="column">
                <brls:Box
                        id="video/title/box"
                        width="100%"
                        height="52"
                        paddingLeft="16"
                        paddingRight="16"
                        alignItems="center"
                        focusable="true">
                    <brls:Label
                            id="video/title"
                            width="100%"
                            height="48"
                            fontSize="20"
                            verticalAlign="center"/>
                </brls:Box>

                <brls:Box
                        width="100%"
                        height="24"
                        paddingLeft="16"
                        paddingRight="16"
                        alignItems="center">
                    <SVGImage
                            width="14"
                            height="14"
                            SVG="@res/svg/widget-video-play-count-grey.svg"/>
                    <brls:Label
                            id="video/count"
                            marginLeft="4"
                            marginRight="12"
                            textColor="@theme/font/grey"
                            fontSize="12"
                            singleLine="true"/>
                    <SVGImage
                            width="14"
                            height="14"
                            SVG="@res/svg/widget-video-danmaku-grey.svg"/>
                    <brls:Label
                            id="video/danmaku"
                            marginLeft="4"
                            marginRight="12"
                            textColor="@theme/font/grey"
                            fontSize="12"
                            singleLine="true"/>
                    <SVGImage
                            width="14"
                            height="14"
                            SVG="@res/svg/widget-time-grey.svg"/>
                    <brls:Label
                            id="video/time"
                            marginLeft="4"
                            textColor="@theme/font/grey"
                            fontSize="12"
                            singleLine="true"/>
                    <brls:Label id="video/people" visibility="gone"/>
                    <brls:Label id="video/bvid" visibility="gone"/>
                    <brls:Box id="video/favorites/box" visibility="gone">
                        <brls:Label id="video/favorites"/>
                    </brls:Box>
                    <brls:Box id="video/right/box" visibility="gone"/>
                </brls:Box>

                <UserInfoView
                        id="video_author"
                        width="100%"
                        height="62"
                        marginLeft="6"
                        marginRight="6"
                        focusable="true"/>

                <brls:Box
                        id="video/detail/actions"
                        width="100%"
                        height="70"
                        paddingLeft="12"
                        paddingRight="12"
                        justifyContent="spaceEvenly"
                        alignItems="center">
                    <brls:Box
                            width="92"
                            height="62"
                            axis="column"
                            alignItems="center"
                            justifyContent="center"
                            highlightCornerRadius="8"
                            focusable="true">
                        <SVGImage id="video/btn/agree" width="30" height="30"/>
                        <brls:Label
                                id="video/label/agree"
                                width="92"
                                height="20"
                                fontSize="13"
                                horizontalAlign="center"
                                textColor="@theme/font/grey"
                                singleLine="true"
                                text="0"/>
                    </brls:Box>
                    <brls:Box
                            width="92"
                            height="62"
                            axis="column"
                            alignItems="center"
                            justifyContent="center"
                            highlightCornerRadius="8"
                            focusable="true">
                        <SVGImage id="video/btn/coin" width="30" height="30"/>
                        <brls:Label
                                id="video/label/coin"
                                width="92"
                                height="20"
                                fontSize="13"
                                horizontalAlign="center"
                                textColor="@theme/font/grey"
                                singleLine="true"
                                text="0"/>
                    </brls:Box>
                    <brls:Box
                            width="92"
                            height="62"
                            axis="column"
                            alignItems="center"
                            justifyContent="center"
                            highlightCornerRadius="8"
                            focusable="true">
                        <SVGImage id="video/btn/favorite" width="30" height="30"/>
                        <brls:Label
                                id="video/label/favorite"
                                width="92"
                                height="20"
                                fontSize="13"
                                horizontalAlign="center"
                                textColor="@theme/font/grey"
                                singleLine="true"
                                text="0"/>
                    </brls:Box>
                    <brls:Box
                            width="92"
                            height="62"
                            axis="column"
                            alignItems="center"
                            justifyContent="center"
                            highlightCornerRadius="8"
                            focusable="true">
                        <SVGImage
                                id="video/btn/qr"
                                width="30"
                                height="30"
                                SVG="@res/svg/bpx-svg-sprite-share.svg"/>
                        <brls:Label
                                id="video/label/qr"
                                width="92"
                                height="20"
                                fontSize="13"
                                horizontalAlign="center"
                                textColor="@theme/font/grey"
                                singleLine="true"
                                text="0"/>
                    </brls:Box>
                </brls:Box>
            </brls:Box>
        </brls:Box>

        <brls:Box
                id="video_detail_right_box"
                width="100%"
                height="100%"
                grow="1"
                shrink="0"
                axis="column">
            <AutoTabFrame
                    id="player/tab_frame"
                    width="100%"
                    height="100%"
                    grow="1"
                    demandMode="false"
                    tabHeight="52"
                    tabBackgroundColor="@theme/color/grey_1"
                    tabItemActiveTextColor="@theme/color/bilibili"
                    defaultTab="0"
                    sidebarPosition="top">
                <Tab label="@i18n/silisili/player/comment" fontSize="17" style="compact">
                    <brls:Box
                            width="100%"
                            height="100%"
                            grow="1"
                            shrink="0"
                            marginTop="8">
                        <RecyclingGrid
                                id="video/comment/recyclingGrid"
                                width="100%"
                                height="100%"
                                paddingLeft="12"
                                paddingRight="12"
                                grow="1"
                                shrink="0"
                                spanCount="1"
                                itemSpace="8"
                                flowMode="true"
                                itemHeight="100"/>
                    </brls:Box>
                </Tab>
            </AutoTabFrame>
        </brls:Box>
    </brls:Box>
</brls:AppletFrame>
