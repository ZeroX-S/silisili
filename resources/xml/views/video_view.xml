<brls:Box
        width="100%"
        height="100%"
        axis="column"
        justifyContent="spaceBetween"
        alignItems="center">
    <brls:Box
            id="video/osd/top/box"
            width="100%"
            height="64"
            backgroundStartColor="#000000CC"
            backgroundEndColor="#00000000"
            background="vertical_linear">
        <brls:Box
                id="video/osd/back"
                positionType="absolute"
                positionLeft="4"
                positionTop="4"
                width="56"
                height="56"
                alignItems="center"
                justifyContent="center"
                hideClickAnimation="true">
            <SVGImage
                    width="30"
                    height="30"
                    SVG="@res/svg/bpx-svg-sprite-back.svg"/>
        </brls:Box>
        <brls:Label
                id="video/osd/title"
                width="100%"
                height="34"
                marginLeft="64"
                marginRight="132"
                fontSize="19"
                singleLine="true"
                textColor="#FFFFFF"/>
        <brls:Box
                positionType="absolute"
                positionLeft="64"
                positionBottom="4"
                height="22"
                alignItems="center">
            <SVGImage width="14" height="14" SVG="@res/svg/widget-people.svg"/>
            <brls:Label
                    id="video/view/label/people"
                    marginLeft="5"
                    fontSize="13"
                    singleLine="true"
                    textColor="#FFFFFF"
                    text="N人正在看"/>
        </brls:Box>
        <brls:Box
                id="video/osd/cast"
                positionType="absolute"
                positionRight="60"
                positionTop="4"
                width="56"
                height="56"
                alignItems="center"
                justifyContent="center"
                hideClickAnimation="true">
            <SVGImage
                    id="video/osd/cast/icon"
                    width="30"
                    height="30"
                    focusable="true"
                    hideHighlightBackground="true"
                    highlightCornerRadius="28"
                    SVG="@res/svg/bpx-svg-sprite-cast.svg"/>
        </brls:Box>
        <brls:Box
                id="video/osd/setting"
                positionType="absolute"
                positionRight="4"
                positionTop="4"
                width="56"
                height="56"
                alignItems="center"
                justifyContent="center"
                hideClickAnimation="true">
            <SVGImage
                    id="video/osd/setting/icon"
                    width="30"
                    height="30"
                    focusable="true"
                    hideHighlightBackground="true"
                    highlightCornerRadius="28"
                    SVG="@res/svg/bpx-svg-sprite-setting.svg"/>
        </brls:Box>
        <brls:Box
                id="video/speed/hint/box"
                width="100%"
                positionType="absolute"
                positionBottom="-8"
                visibility="gone"
                justifyContent="center"
                alignItems="center">
            <brls:Box
                    backgroundColor="#00000080"
                    cornerRadius="4"
                    justifyContent="center"
                    alignItems="center">
                <brls:Label
                        id="video/speed/hint/label"
                        marginLeft="48"
                        marginRight="8"
                        marginTop="4"
                        marginBottom="4"
                        fontSize="14"
                        textColor="#FFFFFF"/>
            </brls:Box>
        </brls:Box>
    </brls:Box>

    <brls:Box
            id="video/osd/center/box2"
            width="96"
            height="82"
            axis="column"
            alignItems="center"
            justifyContent="center"
            visibility="gone"
            cornerRadius="4"
            backgroundColor="#303030A0">
        <SVGImage id="video/osd/center/icon2" width="30" height="30" marginBottom="8"/>
        <brls:Label
                id="video/osd/center/label2"
                width="92"
                height="20"
                fontSize="16"
                horizontalAlign="center"
                verticalAlign="center"
                textColor="#FFFFFF"/>
    </brls:Box>

    <brls:Box
            id="video/osd/center/box"
            axis="column"
            alignItems="center">
        <brls:ProgressSpinner id="video/osd/loading" width="56" height="56"/>
        <brls:Label
                id="video/osd/center/label"
                height="20"
                fontSize="15"
                visibility="invisible"
                cornerRadius="4"
                backgroundColor="#303030A0"
                horizontalAlign="center"
                verticalAlign="center"
                textColor="#FFFFFF"/>
    </brls:Box>

    <brls:Box
            id="video/osd/bottom/box"
            width="100%"
            height="88"
            axis="row"
            alignItems="center"
            backgroundStartColor="#00000000"
            backgroundEndColor="#000000CC"
            background="vertical_linear">
        <brls:Box
                id="video/osd/toggle"
                width="60"
                height="60"
                marginLeft="8"
                alignItems="center"
                justifyContent="center"
                focusable="true"
                hideHighlightBackground="true"
                highlightCornerRadius="30"
                hideClickAnimation="true">
            <SVGImage
                    id="video/osd/toggle/icon"
                    width="34"
                    height="34"
                    SVG="@res/svg/bpx-svg-sprite-play.svg"/>
        </brls:Box>
        <brls:Box width="auto" height="88" grow="1" axis="column">
            <VideoProgressSlider
                    id="video/osd/bottom/progress"
                    width="100%"
                    height="28"
                    marginTop="2"
                    focusable="false"/>
            <brls:Box width="100%" height="58" alignItems="center">
                <brls:Label
                        id="video/left/status"
                        width="46"
                        height="58"
                        fontSize="14"
                        horizontalAlign="right"
                        verticalAlign="center"
                        textColor="#FFFFFF"
                        text="00:00"/>
                <brls:Label
                        id="video/center/status"
                        width="10"
                        height="58"
                        fontSize="14"
                        horizontalAlign="center"
                        verticalAlign="center"
                        textColor="#FFFFFF"
                        text="/"/>
                <brls:Label
                        id="video/right/status"
                        width="46"
                        height="58"
                        fontSize="14"
                        horizontalAlign="left"
                        verticalAlign="center"
                        textColor="#FFFFFF"
                        text="00:00"/>
                <brls:Box
                        id="video/osd/icon/box"
                        height="58"
                        positionType="absolute"
                        positionRight="2"
                        alignItems="center">
                    <brls:Box
                            id="video/osd/danmaku/box/volume"
                            width="1"
                            height="1"
                            visibility="gone">
                        <SVGImage
                                id="video/osd/danmaku/volume/icon"
                                width="1"
                                height="1"
                                SVG="@res/svg/bpx-svg-sprite-volume.svg"/>
                    </brls:Box>
                    <brls:Box
                            id="video/osd/danmaku/box/setting"
                            width="1"
                            height="1"
                            visibility="gone">
                        <SVGImage
                                id="video/osd/danmaku/setting/icon"
                                width="1"
                                height="1"
                                SVG="@res/svg/bpx-svg-sprite-danmu-setting.svg"/>
                    </brls:Box>
                    <brls:Box
                            id="video/osd/danmaku/box/toggle"
                            width="52"
                            height="52"
                            alignItems="center"
                            justifyContent="center"
                            hideClickAnimation="true">
                        <SVGImage
                                id="video/osd/danmaku/icon"
                                width="30"
                                height="30"
                                focusable="true"
                                hideHighlightBackground="true"
                                highlightCornerRadius="26"
                                SVG="@res/svg/bpx-svg-sprite-danmu-switch-on.svg"/>
                    </brls:Box>
                    <brls:Box
                            width="66"
                            height="52"
                            alignItems="center"
                            justifyContent="center"
                            hideClickAnimation="true">
                        <brls:Label
                                id="video/quality"
                                width="66"
                                fontSize="14"
                                horizontalAlign="center"
                                singleLine="true"
                                focusable="true"
                                hideHighlightBackground="true"
                                highlightCornerRadius="8"
                                textColor="#FFFFFF"/>
                    </brls:Box>
                    <brls:Box
                            width="54"
                            height="52"
                            alignItems="center"
                            justifyContent="center"
                            hideClickAnimation="true">
                        <brls:Label
                                id="video/speed"
                                width="54"
                                fontSize="14"
                                horizontalAlign="center"
                                singleLine="true"
                                focusable="true"
                                hideHighlightBackground="true"
                                highlightCornerRadius="8"
                                textColor="#FFFFFF"
                                text="@i18n/silisili/player/speed"/>
                    </brls:Box>
                    <brls:Box width="1" height="1" visibility="gone">
                        <brls:Label id="show/episode" visibility="gone"/>
                    </brls:Box>
                    <brls:Box
                            id="video/osd/fullscreen"
                            width="52"
                            height="52"
                            alignItems="center"
                            justifyContent="center"
                            hideClickAnimation="true">
                        <SVGImage
                                id="video/osd/fullscreen/icon"
                                width="30"
                                height="30"
                                focusable="true"
                                hideHighlightBackground="true"
                                highlightCornerRadius="26"
                                SVG="@res/svg/bpx-svg-sprite-fullscreen.svg"/>
                    </brls:Box>
                </brls:Box>
            </brls:Box>
            <brls:Box
                    id="video/osd/hint/box"
                    height="28"
                    positionType="absolute"
                    positionBottom="56"
                    visibility="gone"
                    cornerRadius="4"
                    backgroundColor="@theme/brls/backdrop">
                <brls:Label
                        id="video/osd/hint/label"
                        maxWidth="520"
                        marginLeft="8"
                        marginRight="8"
                        marginTop="3"
                        marginBottom="3"
                        fontSize="13"
                        textColor="#FFFFFF"/>
            </brls:Box>
        </brls:Box>
    </brls:Box>

    <VideoProfile
            id="video/profile"
            positionType="absolute"
            positionTop="8"
            positionLeft="8"
            visibility="invisible"/>
    <brls:Box
            id="video/osd/lock/box"
            width="44"
            height="44"
            positionType="absolute"
            positionTop="45%"
            positionRight="12"
            alignItems="center"
            justifyContent="center"
            focusable="true"
            hideHighlightBackground="true"
            highlightCornerRadius="22"
            cornerRadius="6"
            backgroundColor="#303030A0">
        <SVGImage
                id="video/osd/lock/icon"
                width="22"
                height="22"
                SVG="@res/svg/player-unlock.svg"/>
    </brls:Box>
</brls:Box>
