diff --git a/libavcodec/v4l2_buffers.c b/libavcodec/v4l2_buffers.c
index d8b0061..955a69c 100644
--- a/libavcodec/v4l2_buffers.c
+++ b/libavcodec/v4l2_buffers.c
@@ -29,6 +29,7 @@
 #include <poll.h>
 #include "libavcodec/avcodec.h"
+#include "libavutil/mem.h"
 #include "libavutil/pixdesc.h"
 #include "v4l2_context.h"
 #include "v4l2_buffers.h"
@@ -495,7 +496,7 @@ int ff_v4l2_buffer_initialize(V4L2Buffer* avbuf, int index)
     V4L2Context *ctx = avbuf->context;
     int ret, i;
 
-    avbuf->buf.memory = V4L2_MEMORY_MMAP;
+    avbuf->buf.memory = ctx->memory;
     avbuf->buf.type = ctx->type;
     avbuf->buf.index = index;
 
@@ -504,9 +505,39 @@ int ff_v4l2_buffer_initialize(V4L2Buffer* avbuf, int index)
         avbuf->buf.m.planes = avbuf->planes;
     }
 
+    if (ctx->memory == V4L2_MEMORY_USERPTR) {
+        if (V4L2_TYPE_IS_MULTIPLANAR(ctx->type)) {
+            avbuf->num_planes = ctx->format.fmt.pix_mp.num_planes;
+            if (avbuf->num_planes < 1)
+                avbuf->num_planes = 1;
+        } else {
+            avbuf->num_planes = 1;
+        }
+
+        for (i = 0; i < avbuf->num_planes; i++) {
+            size_t length = V4L2_TYPE_IS_MULTIPLANAR(ctx->type) ?
+                ctx->format.fmt.pix_mp.plane_fmt[i].sizeimage :
+                ctx->format.fmt.pix.sizeimage;
+            if (!length)
+                return AVERROR(EINVAL);
+            avbuf->plane_info[i].bytesperline =
+                V4L2_TYPE_IS_MULTIPLANAR(ctx->type) ?
+                ctx->format.fmt.pix_mp.plane_fmt[i].bytesperline :
+                ctx->format.fmt.pix.bytesperline;
+            avbuf->plane_info[i].length = length;
+            avbuf->plane_info[i].mm_addr = av_mallocz(length);
+            if (!avbuf->plane_info[i].mm_addr)
+                return AVERROR(ENOMEM);
+            if (V4L2_TYPE_IS_MULTIPLANAR(ctx->type)) {
+                avbuf->planes[i].m.userptr =
+                    (unsigned long)avbuf->plane_info[i].mm_addr;
+                avbuf->planes[i].length = length;
+            } else {
+                avbuf->buf.m.userptr =
+                    (unsigned long)avbuf->plane_info[i].mm_addr;
+                avbuf->buf.length = length;
+            }
+        }
+        avbuf->buf.length = V4L2_TYPE_IS_MULTIPLANAR(ctx->type) ?
+                            avbuf->num_planes : avbuf->buf.length;
+        avbuf->status = V4L2BUF_AVAILABLE;
+        return V4L2_TYPE_IS_OUTPUT(ctx->type) ? 0 :
+               ff_v4l2_buffer_enqueue(avbuf);
+    }
+
     ret = ioctl(buf_to_m2mctx(avbuf)->fd, VIDIOC_QUERYBUF, &avbuf->buf);
     if (ret < 0)
         return AVERROR(errno);
